{
  "name": "poker-solver",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first No-Limit Hold'em study tool: preflop charts, equity, push/fold and a CFR solver, all in the browser",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/precache.mjs",
    "lint": "biome check",
    "format": "biome format --write",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:push-fold": "node --import ./scripts/ts-hooks.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-push-fold.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
